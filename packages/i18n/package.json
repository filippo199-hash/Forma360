{
  "name": "@forma360/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./request": {
      "types": "./src/request.ts",
      "default": "./src/request.ts"
    },
    "./routing": {
      "types": "./src/routing.ts",
      "default": "./src/routing.ts"
    },
    "./brand-messages": {
      "types": "./src/brand-messages.ts",
      "default": "./src/brand-messages.ts"
    },
    "./messages/*": "./messages/*.json",
    "./overrides/*": "./overrides/*.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@forma360/shared": "workspace:^",
    "next-intl": "^4.0.0"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
