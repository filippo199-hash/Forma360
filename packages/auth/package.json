{
  "name": "@forma360/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./crypto": {
      "types": "./src/crypto.ts",
      "default": "./src/crypto.ts"
    },
    "./sandbox-session": {
      "types": "./src/sandbox-session.ts",
      "default": "./src/sandbox-session.ts"
    }
