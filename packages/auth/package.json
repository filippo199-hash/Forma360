    "test:watch": "vitest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@better-auth/redis-storage": "^1.6.5",
    "@forma360/db": "workspace:^",
    "@forma360/shared": "workspace:^",
    "better-auth": "^1.6.5",
    "drizzle-orm": "^0.45.0",
    "ioredis": "^5.4.1",
    "kysely": "0.28.16",
    "zod": "^3.24.0"
  }
