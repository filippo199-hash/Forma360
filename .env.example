# ─────────────────────────────────────────────────────────────────────────────
# Forma360 environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# This file is parsed by packages/shared/src/env.ts at boot (wired in PR 2).
# ─────────────────────────────────────────────────────────────────────────────

# Node environment: "development" | "test" | "production"
NODE_ENV=development

# Public app URL (e.g. https://forma360.com, or http://localhost:3000 locally)
APP_URL=http://localhost:3000

# ─── Brand (ADR 0010) ────────────────────────────────────────────────────────
# Which product identity this deployment serves: "forma360" | "freehs".
# One deployment serves exactly one brand. Set BOTH variables to the same
# value — NEXT_PUBLIC_BRAND is the build-time mirror the client bundle reads,
# and boot fails if they disagree. Leave both unset for local dev (defaults
# to forma360).
BRAND=forma360
NEXT_PUBLIC_BRAND=forma360

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string (pg URI).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forma360

# ─── Redis ───────────────────────────────────────────────────────────────────
# Used by BullMQ and better-auth secondary session storage.
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# Random 32+ byte string. Rotate carefully — rotating invalidates sessions.
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes-min
# Base URL better-auth uses for callbacks and cookie domain scoping.
BETTER_AUTH_URL=http://localhost:3000

# ─── Object storage (Cloudflare R2) ──────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=forma360-dev
# Public URL for serving uploaded assets (custom R2 domain or R2 public URL).
R2_PUBLIC_URL=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
# "Forma360 <noreply@forma360.com>" or similar. Must be from a verified domain.
RESEND_FROM=

# Controls how transactional email is delivered.
#   "resend"  — real delivery via Resend (production, staging)
#   "console" — writes the email payload (including verification links) to the
#               structured logger. Only permitted when NODE_ENV != "production";
#               boot will fail if combined with NODE_ENV=production.
EMAIL_DELIVERY=console

# ─── AI Assistant ────────────────────────────────────────────────────────────
# Anthropic API key — generate at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI API key — used ONLY for Whisper speech-to-text of WhatsApp voice notes
# (all reasoning stays on Claude). Optional; blank disables voice transcription.
OPENAI_API_KEY=

# ─── WhatsApp Cloud API (AI assistant over WhatsApp) ─────────────────────────
# Optional: set all four to enable the WhatsApp agent webhook. Leave blank to
# disable. See Meta App → WhatsApp → API Setup.
# Arbitrary string you choose; must match the Meta webhook "Verify token".
WHATSAPP_VERIFY_TOKEN=
# Cloud API access token (temp 24h token, or a System User permanent token).
WHATSAPP_ACCESS_TOKEN=
# Phone number ID shown under "From" in API Setup.
WHATSAPP_PHONE_NUMBER_ID=
# Meta App secret (App Settings → Basic) — verifies inbound webhook signatures.
WHATSAPP_APP_SECRET=
# The public WhatsApp Business number, e.g. +447405582158. Read by the CLIENT
# bundle to build the wa.me link behind "Get this on WhatsApp"; leave blank and
# that prompt hides itself. Not a secret — customers are meant to message it.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Rendered output (Phase 2 PR 31) ─────────────────────────────────────────
# Shared HMAC secret used by the internal PDF render route. Min 32 chars.
# Rotating invalidates in-flight render tokens, not cached artefacts.
RENDER_SHARED_SECRET=replace-me-with-32-random-bytes-min

# ─── Observability (ADR 0016) ────────────────────────────────────────────────
# Server-side Sentry DSN (worker + Next server + edge routes). Leave empty
# to disable: the SDK no-ops and the build still succeeds.
SENTRY_DSN=
# Client-side Sentry DSN exposed to the browser bundle. Separate project
# from the server so the browser never carries the server project's key.
NEXT_PUBLIC_SENTRY_DSN=
# Environment name Sentry groups by. Defaults to RAILWAY_ENVIRONMENT_NAME,
# then NODE_ENV — set explicitly only to override.
SENTRY_ENVIRONMENT=
# Build-time source-map upload. Without these the build succeeds and you
# get minified stack frames. Create the token at
# Sentry → Settings → Auth Tokens with scope `project:releases`.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# LAST-RESORT timezone for printed documents (permit PDF, incident PDF).
# The clock follows the work: a site's own timezone wins, then the tenant
# default (Settings -> Company), and only then this. Set it to wherever most
# of the deployment's work happens. Defaults to Europe/London — the subject
# matter is British H&S law.
APP_TIMEZONE=Europe/London

# pino log level: "trace" | "debug" | "info" | "warn" | "error" | "fatal"
LOG_LEVEL=info
