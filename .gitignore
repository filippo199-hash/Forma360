# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
.turbo/
*.tsbuildinfo
# `build/` unanchored matches ANY directory of that name at any depth — which
# silently swallowed `app/[locale]/rams/[packId]/build/`, an App Router route
# whose segment is legitimately called "build". The file was written, `git add
# -A` skipped it without a word, and RAMS shipped with its builder 404ing for
# a second time. Anchored to the repo root and to package roots, so a route
# segment can never be mistaken for a build artefact again.
/build/
/apps/*/build/
/packages/*/build/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Testing
coverage/
playwright-report/
test-results/
.playwright/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Misc
*.pid
*.seed
*.pid.lock

# local prod-db helper scripts (not for commit)
packages/db/apply-prod.mjs
packages/db/verify-prod.mjs

# Dev-mode upload blobs (apps/web writes here instead of R2 outside production)
.local-storage/
