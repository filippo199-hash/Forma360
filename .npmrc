auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
prefer-workspace-packages=true

# Always install devDependencies, including when Railway / Docker sets
# NODE_ENV=production for the build phase. Next.js's post-compile type
# check needs typescript + @types/node, and our pnpm scripts (tsx for
# the Worker) need their build tools too. Production runtime images
# don't ship node_modules in the final layer, so the prod-skip
# behaviour buys nothing here and breaks the build.
prod=false
